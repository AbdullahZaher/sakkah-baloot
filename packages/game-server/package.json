{
  "name": "@sakkah-baloot/game-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sakkah-baloot/game-engine": "workspace:*",
    "@sakkah-baloot/game-protocol": "workspace:*"
  },
  "devDependencies": {
    "@sakkah-baloot/game-ai": "workspace:*",
    "typescript": "^5.0.0",
    "tsx": "^4.20.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @sakkah-baloot/game-engine build && pnpm --filter @sakkah-baloot/game-protocol build && npm run build && tsx --test test/*.test.mjs"
  }
}
